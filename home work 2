name = 0
for i in range(1, 101):
  if i % 2 != 0:
    name += i

print(f"Сума непарних чисел від 1 до 100: {name}")

text = input("Введіть рядок: ")

if len(text) > 0:
  name = text[0]
  count = text.count(name)

  print(f"Перша літера: '{name}'")
  print(f"Кількість її входжень у рядок: {count}")
else:
  print("Ви ввели порожній рядок.")
